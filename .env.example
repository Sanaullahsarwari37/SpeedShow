# Public URL of your deployed site (used for canonical URLs, sitemap, Open Graph).
# On Vercel this is auto-detected, but set it when you add a custom domain.
NEXT_PUBLIC_SITE_URL=https://speedshow.vercel.app

# Optional: free key from https://ipapi.is — raises limits for VPN detection.
# Without it the check still works (name heuristics + ipapi.is anonymous quota).
IPAPI_KEY=

# VPN users can always run the test; they just see a short note. Set to "off" to skip VPN detection.
VPN_CHECK=

# Optional: Open-Meteo commercial API key (only needed for commercial use).
# https://open-meteo.com/en/pricing
OPEN_METEO_API_KEY=

# Optional: Google Maps Platform Weather API key (server-side only; billing must be enabled).
# When set, weather comes from Google; without it, or if Google fails, Open-Meteo is used.
# Enable "Weather API" at https://console.cloud.google.com/apis/library/weather.googleapis.com
# and restrict the key to that API. GOOGLE_MAPS_API_KEY is also accepted.
GOOGLE_WEATHER_API_KEY=

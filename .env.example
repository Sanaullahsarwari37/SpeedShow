# Public URL of your deployed site (used for canonical URLs, sitemap, Open Graph).
# On Vercel this is auto-detected, but set it when you add a custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: free key from https://ipapi.is — raises limits for the VPN / proxy check.
# Without it the check still works (name heuristics + ipapi.is anonymous quota).
IPAPI_KEY=

# Set to "off" to disable the VPN / proxy block page entirely.
BLOCK_VPN=on

# Optional: Open-Meteo commercial API key (only needed for commercial use).
# https://open-meteo.com/en/pricing
OPEN_METEO_API_KEY=
